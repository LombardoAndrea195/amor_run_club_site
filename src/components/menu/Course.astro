---
interface Props { id: string; name: string; price: string; dish: string }
const { id, name, price, dish } = Astro.props;
---

<section class="course" id={id} aria-labelledby={`${id}-h`}>
  <div class="course__line">
    <h2 id={`${id}-h`}>{name} <span class="course__dish">{dish}</span></h2>
    <span class="course__dots" aria-hidden="true"></span>
    <span class="course__price hand">{price}</span>
  </div>
  <slot />
</section>
