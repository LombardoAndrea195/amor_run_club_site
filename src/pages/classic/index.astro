---
import "@fontsource/anton";
import "@fontsource-variable/familjen-grotesk";
import "../../styles/classic.css";
import { Image } from "astro:assets";
import { site, photos, gallery } from "../../data/site";
import ReleaseText from "../../components/shared/ReleaseText.astro";
import mascot from "../../assets/mascot.png";
import wordmark from "../../assets/wordmark.png";

const title = "Amor Run Club — Run, laugh and connect in Rome";
const spans = ["t-big", "t-tall", "t-tall", "t-wide", "", "", "t-tall", "", "", "t-tall", "t-wide", "t-wide", "", ""];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#121212" />
    <link rel="icon" href={import.meta.env.BASE_URL + "brand/icon-192.png"} />
  </head>
  <body class="classic">
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav" data-nav>
      <a href="#top" class="nav__brand" aria-label="Amor Run Club, back to top">
        <Image src={wordmark} alt="" width={160} class="nav__wordmark" />
      </a>
      <nav aria-label="Primary">
        <ul>
          <li><a href="#rome">Rome</a></li>
          <li><a href="#events">Events</a></li>
          <li><a href="#gallery">Gallery</a></li>
          <li><a class="pill pill--sm" href="#join">Join the club</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero__media">
          <Image src={photos.groupPiazza.src} alt={photos.groupPiazza.alt} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="hero__photo" />
          <video class="hero__video" muted loop playsinline preload="metadata" aria-hidden="true" data-poster={import.meta.env.BASE_URL + "video/hero-poster.jpg"} data-poster-portrait={import.meta.env.BASE_URL + "video/hero-poster-portrait.jpg"} data-hero-video>
            <source media="(max-width: 700px)" src={import.meta.env.BASE_URL + "video/hero-loop-portrait.webm"} type="video/webm" />
            <source media="(max-width: 700px)" src={import.meta.env.BASE_URL + "video/hero-loop-portrait.mp4"} type="video/mp4" />
            <source src={import.meta.env.BASE_URL + "video/hero-loop.webm"} type="video/webm" />
            <source src={import.meta.env.BASE_URL + "video/hero-loop.mp4"} type="video/mp4" />
          </video>
        </div>
        <div class="hero__scrim"></div>
        <div class="hero__content">
          <h1 id="hero-title" class="display hero__title">
            <span class="line"><span>Run, laugh</span></span>
            <span class="line"><span>and connect</span></span>
          </h1>
          <p class="hero__sub">Join Amor Run Club. Every pace welcome in Rome.</p>
          <div class="hero__ctas">
            <a class="pill" href="#join">Join the club</a>
            <a class="textlink" href={site.links.instagram} rel="noopener">Follow on Instagram</a>
          </div>
        </div>
        <button class="hero__toggle" type="button" data-video-toggle aria-pressed="false" data-label-play="Play background video" data-label-pause="Pause background video" aria-label="Pause background video">
          <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" /><rect x="14" y="5" width="4" height="14" /></svg>
          <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5v14l12-7z" /></svg>
        </button>
      </section>
      <div class="sentinel" data-nav-sentinel aria-hidden="true"></div>

      <section class="band" aria-labelledby="motto">
        <figure class="band__inner">
          <blockquote>
            <p id="motto" class="display band__quote">Eat pasta run fasta.</p>
          </blockquote>
          <figcaption>Anonymous runner</figcaption>
        </figure>
        <Image src={mascot} alt="The Amor Run Club mascot: a running rigatone in red sneakers" width={420} class="band__mascot" />
      </section>

      <section class="split" id="rome" aria-labelledby="rome-title">
        <div class="split__media">
          <Image src={photos.runParkCheer.src} alt={photos.runParkCheer.alt} widths={[600, 1000, 1400]} sizes="(max-width: 860px) 100vw, 50vw" />
        </div>
        <div class="split__text">
          <h2 id="rome-title" class="display h2">Explore Rome</h2>
          <p>Be a part of the Amor Run Club community and experience the joy of running together through the beautiful streets of Rome. Whether you’re looking to improve your fitness, make new friends, or simply enjoy the city from a different perspective, we welcome runners of all levels.</p>
          <p>Join us for our weekly runs and social gatherings, and make the most of your time in the Eternal City.</p>
          <a class="pill pill--ghost" href={site.links.strava} rel="noopener">Join the club on Strava</a>
        </div>
      </section>

      <section class="split split--rev" aria-labelledby="involved-title">
        <div class="split__media">
          <Image src={photos.handshakePiazza.src} alt={photos.handshakePiazza.alt} widths={[600, 1000, 1400]} sizes="(max-width: 860px) 100vw, 50vw" />
        </div>
        <div class="split__text">
          <h2 id="involved-title" class="display h2">Get involved</h2>
          <p>Amor Run Club in Rome is your gateway to fitness and fun. Whether you’re a seasoned runner or just starting out, our inclusive environment welcomes all levels.</p>
          <p>We organize scenic runs through Rome’s beautiful landscapes, followed by social events to bond over shared passions. Come run with us and discover the magic of running together.</p>
          <a class="pill pill--ghost" href={site.links.whatsapp} rel="noopener">Join our WhatsApp community</a>
        </div>
      </section>

      <section class="events" id="events" aria-labelledby="events-title">
        <h2 id="events-title" class="display h2">Upcoming events</h2>
        <ul class="events__list">
          {site.events.map((e) => (
            <li class="event">
              <h3 class="display event__title">{e.title}</h3>
              <p class="event__meta"><span class="num">{e.distance}</span> · {e.note}</p>
              <a class="textlink" href={site.links.instagram} rel="noopener">Details on Instagram</a>
            </li>
          ))}
        </ul>
        <p class="events__note">{site.copy.eventsNote} <a class="textlink" href={site.links.instagram} rel="noopener">Follow on Instagram</a></p>
      </section>

      <section class="gallery" id="gallery" aria-labelledby="gallery-title">
        <h2 id="gallery-title" class="display h2">The club, lately</h2>
        <ul class="grid">
          {gallery.map((p, i) => (
            <li class:list={["tile", spans[i]]} data-reveal>
              <Image src={p.src} alt={p.alt} widths={[400, 800, 1200]} sizes="(max-width: 700px) 50vw, 25vw" />
            </li>
          ))}
        </ul>
      </section>

      <section class="join" id="join" aria-labelledby="join-title">
        <div class="join__intro">
          <h2 id="join-title" class="display h2">Join the club</h2>
          <p>Free, social and open to every pace. Leave your details and we’ll keep you posted on the next run.</p>
        </div>
        <div class="join__panel">
          <form class="form" data-entry-form novalidate>
            <div class="field">
              <label for="f-name">Name</label>
              <input id="f-name" name="name" type="text" autocomplete="name" aria-describedby="e-name" />
              <p class="err" id="e-name" data-error-for="name"></p>
            </div>
            <div class="field">
              <label for="f-email">Email</label>
              <input id="f-email" name="email" type="email" autocomplete="email" aria-describedby="e-email" />
              <p class="err" id="e-email" data-error-for="email"></p>
            </div>
            <div class="field">
              <label for="f-ig">Instagram <span class="opt">(optional)</span></label>
              <input id="f-ig" name="instagram" type="text" placeholder="@yourhandle" aria-describedby="e-ig" />
              <p class="err" id="e-ig" data-error-for="instagram"></p>
            </div>
            <div class="field field--check">
              <input id="f-accept" name="accept" type="checkbox" aria-describedby="e-accept" />
              <label for="f-accept">I accept the <button type="button" class="inline-btn" data-open-release>Release of Liability</button></label>
              <p class="err" id="e-accept" data-error-for="accept"></p>
            </div>
            <button class="pill pill--lg" type="submit"><span class="when-idle">Join the club</span><span class="when-sending">Sending…</span></button>
          </form>
          <div class="success" data-form-success hidden>
            <p class="display success__title">You’re in, <span data-success-name></span>.</p>
            <p>See you at the next run. Dates and meeting points land on Instagram first.</p>
            <a class="pill pill--ghost" href={site.links.instagram} rel="noopener">Follow on Instagram</a>
          </div>
        </div>
      </section>
    </main>

    <dialog class="sheet" data-release aria-labelledby="sheet-title">
      <div class="sheet__head">
        <p id="sheet-title" class="sheet__label">Release of Liability</p>
        <button type="button" class="sheet__close" data-close-release aria-label="Close Release of Liability">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <div class="sheet__body"><ReleaseText headingLevel={2} /></div>
    </dialog>

    <footer class="foot">
      <div class="foot__top">
        <Image src={wordmark} alt="Amor Run Club" width={220} class="foot__wordmark" />
        <ul class="foot__social">
          <li><a href={site.links.instagram} rel="noopener">Instagram</a></li>
          <li><a href={site.links.strava} rel="noopener">Strava</a></li>
          <li><a href={site.links.whatsapp} rel="noopener">WhatsApp</a></li>
        </ul>
      </div>
      <dl class="foot__data">
        <div><dt>Address</dt><dd>{site.legal.address}</dd></div>
        <div><dt>VAT</dt><dd class="num">{site.legal.vat}</dd></div>
        <div><dt>Tax code</dt><dd class="num">{site.legal.taxCode}</dd></div>
      </dl>
      <div class="foot__bottom">
        <p>© <span class="num">2026</span> {site.legalName}</p>
        <p>Design concept for amorrunclub.com — example, not the official site.</p>
        <a href={import.meta.env.BASE_URL + ""}>All directions</a>
      </div>
    </footer>

    <script>
      import { initEntryForms } from "../../scripts/entry-form";
      import { initHeroVideo } from "../../scripts/hero-video";
      initEntryForms();
      initHeroVideo();

      const nav = document.querySelector<HTMLElement>("[data-nav]")!;
      const sentinel = document.querySelector("[data-nav-sentinel]")!;
      new IntersectionObserver(([e]) => nav.classList.toggle("is-solid", !e.isIntersecting), { rootMargin: "-80px 0px 0px 0px" }).observe(sentinel);

      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const tiles = document.querySelectorAll("[data-reveal]");
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add("is-in"); io.unobserve(en.target); } });
      }, { threshold: 0.15 });
      document.documentElement.classList.add("js");
      tiles.forEach((t) => io.observe(t));

      const sheet = document.querySelector<HTMLDialogElement>("[data-release]")!;
      document.querySelector("[data-open-release]")!.addEventListener("click", () => sheet.showModal());
      document.querySelector("[data-close-release]")!.addEventListener("click", () => sheet.close());
      sheet.addEventListener("click", (e) => { if (e.target === sheet) sheet.close(); });
    </script>
  </body>
</html>
