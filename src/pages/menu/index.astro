---
import "@fontsource/shrikhand";
import "@fontsource/gochi-hand";
import "@fontsource-variable/bricolage-grotesque";
import "../../styles/menu.css";
import { Image } from "astro:assets";
import { site, photos, gallery } from "../../data/site";
import ReleaseText from "../../components/shared/ReleaseText.astro";
import Course from "../../components/menu/Course.astro";
import wordmark from "../../assets/wordmark.png";
import mascot from "../../assets/mascot.png";
import logo from "../../assets/logo.png";

const title = "Amor Run Club · Menu del giorno";
const desc = site.description;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/brand/icon-192.png" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/brand/logo.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#efe6b8" />
  </head>
  <body class="menu">
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
      <a href="#main" class="topbar__brand" aria-label="Amor Run Club, top of page">
        <Image src={logo} alt="" width={56} height={56} />
        <span>Trattoria della corsa</span>
      </a>
      <nav aria-label="Main">
        <ul>
          <li><a href="#antipasto">Antipasto</a></li>
          <li><a href="#primo">Primo</a></li>
          <li><a href="#secondo">Secondo</a></li>
          <li><a href="#dolce">Dolce</a></li>
        </ul>
        <a class="stamp stamp--small" href="#comanda">Sign up</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="card">
          <Image src={wordmark} alt="Amor Run Club" class="card__wordmark" width={360} />
          <h1 id="hero-title">Run, laugh and connect</h1>
          <p class="card__sub">Join Amor Run Club</p>
          <p class="card__note">Free social runs in Rome, then pasta. Every pace at the table.</p>
          <div class="card__cta">
            <a class="stamp" href="#comanda">Sign up</a>
            <span class="hand">no reservation needed</span>
          </div>
        </div>

        <figure class="pinned">
          <div class="pinned__frame">
            <Image
              src={photos.groupPiazza.src}
              alt={photos.groupPiazza.alt}
              widths={[600, 900, 1300]}
              sizes="(max-width: 800px) 92vw, 50vw"
              class="pinned__photo"
              loading="eager"
              fetchpriority="high"
            />
            <video
              class="pinned__video"
              muted
              loop
              playsinline
              preload="metadata"
              aria-hidden="true"
              data-poster="/video/hero-poster.jpg" data-poster-portrait="/video/hero-poster-portrait.jpg"
              data-hero-video
            >
              <source media="(max-width: 700px)" src="/video/hero-loop-portrait.webm" type="video/webm" />
              <source media="(max-width: 700px)" src="/video/hero-loop-portrait.mp4" type="video/mp4" />
              <source src="/video/hero-loop.webm" type="video/webm" />
              <source src="/video/hero-loop.mp4" type="video/mp4" />
            </video>
            <button class="pinned__toggle" type="button" data-video-toggle aria-pressed="false" data-label-play="Play video" data-label-pause="Pause video">
              <svg viewBox="0 0 20 20" aria-hidden="true" class="i-pause"><rect x="4" y="3" width="4" height="14" /><rect x="12" y="3" width="4" height="14" /></svg>
              <svg viewBox="0 0 20 20" aria-hidden="true" class="i-play"><path d="M5 3l12 7-12 7z" /></svg>
              <span data-video-label>Pause video</span>
            </button>
          </div>
          <span class="pin" aria-hidden="true"></span>
          <Image src={mascot} alt="" class="pinned__mascot" width={340} />
        </figure>
      </section>

      <div class="frieze" aria-hidden="true"></div>

      <Course id="antipasto" name="Antipasto" price="free" dish="Meet up and explore Rome">
        <div class="plate plate--split">
          <div class="plate__text">
            <p>{site.copy.exploreRome}</p>
            <a class="link-ink" href={site.links.strava} rel="noopener">Join the club on Strava</a>
          </div>
          <div class="duo" data-cook>
            <Image src={photos.handshakePiazza.src} alt={photos.handshakePiazza.alt} widths={[500, 800]} sizes="(max-width: 800px) 92vw, 40vw" />
          </div>
        </div>
      </Course>

      <Course id="primo" name="Primo" price="all paces" dish="The run">
        <div class="plate plate--split plate--flip">
          <div class="duo" data-cook>
            <Image src={photos.runParkCheer.src} alt={photos.runParkCheer.alt} widths={[500, 800]} sizes="(max-width: 800px) 92vw, 40vw" />
          </div>
          <div class="plate__text">
            {site.events.map((e) => (
              <article class="special">
                <h3>{e.title}</h3>
                <p class="special__meta">{e.distance} · easy pace, nobody left behind</p>
                <p>{e.note} {site.copy.eventsNote}</p>
              </article>
            ))}
            <a class="link-ink" href={site.links.instagram} rel="noopener">Follow on Instagram {site.links.instagramHandle}</a>
          </div>
        </div>
      </Course>

      <section class="chalk" aria-label="House special">
        <blockquote>
          <p>“Eat pasta run fasta.”</p>
          <footer>Anonymous runner</footer>
        </blockquote>
      </section>

      <Course id="secondo" name="Secondo" price="free" dish="Pasta after">
        <div class="plate plate--split">
          <div class="plate__text">
            <p>{site.copy.getInvolved}</p>
            <a class="link-ink" href={site.links.whatsapp} rel="noopener">Join our WhatsApp community</a>
          </div>
          <div class="tiles tiles--pasta">
            {[photos.pastaShopTeam, photos.nonnoRavioli, photos.shoeOnScale].map((p) => (
              <div class="duo" data-cook>
                <Image src={p.src} alt={p.alt} widths={[400, 700]} sizes="(max-width: 800px) 46vw, 22vw" />
              </div>
            ))}
          </div>
        </div>
      </Course>

      <Course id="dolce" name="Dolce" price="all you can see" dish="The community">
        <ul class="gallery">
          {gallery.map((p) => (
            <li class="duo" data-cook>
              <Image src={p.src} alt={p.alt} widths={[360, 640]} sizes="(max-width: 800px) 46vw, 24vw" />
            </li>
          ))}
        </ul>
      </Course>

      <section id="comanda" class="order" aria-labelledby="order-title">
        <div class="pad">
          <div class="pad__head">
            <h2 id="order-title">Sign up</h2>
            <p class="hand">tavolo: Amor Run Club · coperti: tutti</p>
          </div>
          <form data-entry-form novalidate class="pad__form">
            <ol>
              <li>
                <label for="m-name">Name</label>
                <input id="m-name" name="name" autocomplete="name" aria-describedby="m-name-err" />
                <p class="err" data-error-for="name" id="m-name-err"></p>
              </li>
              <li>
                <label for="m-email">Email</label>
                <input id="m-email" name="email" type="email" autocomplete="email" aria-describedby="m-email-err" />
                <p class="err" data-error-for="email" id="m-email-err"></p>
              </li>
              <li>
                <label for="m-ig">Instagram <span class="opt">(optional)</span></label>
                <input id="m-ig" name="instagram" autocomplete="off" placeholder="@yourhandle" aria-describedby="m-ig-err" />
                <p class="err" data-error-for="instagram" id="m-ig-err"></p>
              </li>
              <li class="pad__accept">
                <div class="check">
                  <input id="m-accept" name="accept" type="checkbox" aria-describedby="m-accept-err" />
                  <label for="m-accept">I accept the Release of Liability</label>
                </div>
                <button type="button" class="link-ink pad__read" data-open-receipt aria-haspopup="dialog">Read the Release of Liability</button>
                <p class="err" data-error-for="accept" id="m-accept-err"></p>
              </li>
            </ol>
            <button type="submit" class="stamp stamp--wide">
              <span class="when-idle">Sign up</span><span class="when-sending">Sending the order…</span>
            </button>
          </form>
          <div data-form-success hidden class="pad__done">
            <p class="pad__done-title">Order in, <span data-success-name></span>!</p>
            <p>Welcome to the table. Run updates arrive by email; dates and meeting points go up on <a href={site.links.instagram} rel="noopener">Instagram</a> and in the <a href={site.links.whatsapp} rel="noopener">WhatsApp community</a>.</p>
            <p class="hand">grazie, see you at the start</p>
          </div>
        </div>
      </section>

      <dialog class="receipt" aria-labelledby="receipt-title" data-receipt>
        <div class="receipt__paper">
          <p class="receipt__shop" id="receipt-title">Scontrino · Release of Liability</p>
          <ReleaseText headingLevel={2} />
          <form method="dialog">
            <button class="stamp stamp--wide" type="submit">I’ve read it</button>
          </form>
        </div>
      </dialog>
    </main>

    <div class="frieze" aria-hidden="true"></div>
    <footer class="foot">
      <div class="foot__cols">
        <div>
          <p class="foot__name">© 2026 {site.legalName}</p>
          <p>{site.legal.address}<br />VAT {site.legal.vat} · Tax code {site.legal.taxCode}</p>
        </div>
        <ul>
          <li><a href={site.links.instagram} rel="noopener">Instagram</a></li>
          <li><a href={site.links.strava} rel="noopener">Strava</a></li>
          <li><a href={site.links.whatsapp} rel="noopener">WhatsApp</a></li>
        </ul>
      </div>
      <p class="foot__honest">Design concept for amorrunclub.com — example, not the official site. <a href="/">All directions</a></p>
    </footer>

    <script>
      import { initEntryForms } from "../../scripts/entry-form";
      import { initHeroVideo } from "../../scripts/hero-video";
      initEntryForms();
      initHeroVideo();

      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

      const dlg = document.querySelector<HTMLDialogElement>("[data-receipt]");
      document.querySelector("[data-open-receipt]")?.addEventListener("click", () => dlg?.showModal());
      dlg?.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });

      const cooks = document.querySelectorAll<HTMLElement>("[data-cook]");
      if (reduce || !("IntersectionObserver" in window)) {
        cooks.forEach((c) => c.classList.add("is-cooked"));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) { en.target.classList.add("is-cooked"); io.unobserve(en.target); }
          });
        }, { rootMargin: "0px 0px -25% 0px", threshold: 0.35 });
        cooks.forEach((c) => io.observe(c));
      }
    </script>
  </body>
</html>
