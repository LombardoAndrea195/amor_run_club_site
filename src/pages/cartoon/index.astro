---
import "@fontsource/bowlby-one";
import "@fontsource/limelight";
import "@fontsource-variable/hanken-grotesk";
import "../../styles/cartoon.css";
import { Image } from "astro:assets";
import { site, photos, gallery } from "../../data/site";
import ReleaseText from "../../components/shared/ReleaseText.astro";
import wordmark from "../../assets/wordmark.png";
import mascot from "../../assets/mascot.png";

const title = "Amor Run Club · Run, laugh and connect";
const year = 2026;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/brand/icon-192.png" />
    <meta name="theme-color" content="#eceeed" />
    <link rel="icon" href="/brand/icon-192.png" />
  </head>
  <body class="ct">
    <a class="ct-skip" href="#main">Skip to content</a>

    <header class="ct-nav">
      <a href="#top" class="ct-nav__brand" aria-label="Amor Run Club, back to top">
        <Image src={mascot} alt="" width={72} class="ct-nav__mascot" />
        <span>Amor Run Club</span>
      </a>
      <nav aria-label="Main">
        <ul>
          <li><a href="#rome">Rome</a></li>
          <li><a href="#events">Events</a></li>
          <li><a href="#gallery">Gallery</a></li>
          <li><a class="ct-btn ct-btn--small" href="#join">Join the club</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <!-- Title card -->
      <section class="ct-hero" id="top" aria-labelledby="hero-title">
        <div class="ct-hero__card">
          <Image src={wordmark} alt="Amor Run Club" width={520} class="ct-hero__wordmark" loading="eager" />
          <div class="ct-iris">
            <Image
              src={photos.groupPiazza.src}
              alt={photos.groupPiazza.alt}
              widths={[480, 800, 1200]}
              sizes="(max-width: 700px) 70vw, 34vw"
              class="ct-iris__media"
              loading="eager"
              fetchpriority="high"
            />
            <video
              class="ct-iris__media ct-iris__video"
              muted
              loop
              playsinline
              preload="metadata"
              aria-hidden="true"
              data-poster="/video/hero-poster.jpg" data-poster-portrait="/video/hero-poster-portrait.jpg"
              data-hero-video
            >
              <source media="(max-width: 700px)" src="/video/hero-loop-portrait.webm" type="video/webm" />
              <source media="(max-width: 700px)" src="/video/hero-loop-portrait.mp4" type="video/mp4" />
              <source src="/video/hero-loop.webm" type="video/webm" />
              <source src="/video/hero-loop.mp4" type="video/mp4" />
            </video>
            <button class="ct-iris__toggle" type="button" data-video-toggle aria-pressed="false" data-label-play="Play background video" data-label-pause="Pause background video">
              <svg viewBox="0 0 20 20" aria-hidden="true" class="i-pause"><rect x="5" y="4" width="3.5" height="12" rx="1.5"/><rect x="11.5" y="4" width="3.5" height="12" rx="1.5"/></svg>
              <svg viewBox="0 0 20 20" aria-hidden="true" class="i-play"><path d="M6 4.5v11a1 1 0 0 0 1.5.9l9-5.5a1 1 0 0 0 0-1.8l-9-5.5A1 1 0 0 0 6 4.5z"/></svg>
              <span class="ct-sr" data-video-label>Pause background video</span>
            </button>
          </div>
          <div class="ct-hero__copy">
            <p class="ct-credit">Amor Productions presents</p>
            <h1 id="hero-title">Run, laugh and connect</h1>
            <p class="ct-hero__sub">Join Amor Run Club. Free social runs through Rome, every pace welcome, pasta after.</p>
            <a class="ct-btn ct-btn--big" href="#join">Join the club</a>
          </div>
          <div class="ct-runner" aria-hidden="true">
            <img src="/cartoon/speed-lines.svg" alt="" class="ct-runner__lines" />
            <Image src={mascot} alt="" width={220} class="ct-runner__mascot" loading="eager" />
          </div>
        </div>
      </section>

      <!-- Scene: Explore Rome -->
      <section class="ct-scene ct-rome" id="rome" aria-labelledby="rome-title">
        <div class="ct-frame ct-wipe">
          <Image
            src={photos.runParkCheer.src}
            alt={photos.runParkCheer.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 860px) 92vw, 48vw"
          />
        </div>
        <div class="ct-rome__copy">
          <h2 id="rome-title">Explore Rome</h2>
          <p>
            Be a part of the Amor Run Club community and experience the joy of running together through the beautiful
            streets of Rome. Improve your fitness, make new friends, or simply see the city from a different
            perspective: runners of all levels are welcome at our weekly runs and social gatherings.
          </p>
          <a class="ct-btn ct-btn--ghost" href={site.links.strava} rel="noopener" target="_blank">Join the club on Strava</a>
        </div>
      </section>

      <!-- Scene: coming attraction -->
      <section class="ct-scene ct-poster-wrap" id="events" aria-labelledby="events-title">
        <article class="ct-poster ct-wipe">
          <p class="ct-credit">Coming soon to a street near you</p>
          <h2 id="events-title">Easy Run 5K</h2>
          <dl class="ct-poster__facts">
            <div><dt>Distance</dt><dd>5 km, easy pace</dd></div>
            <div><dt>Date</dt><dd>See Instagram</dd></div>
            <div><dt>Starring</dt><dd>You, and whoever shows up</dd></div>
          </dl>
          <p class="ct-poster__note">{site.copy.eventsNote} Date, time and meeting point are announced there.</p>
          <a class="ct-btn" href={site.links.instagram} rel="noopener" target="_blank">Follow on Instagram</a>
        </article>
        <div class="ct-poster__side ct-frame ct-wipe">
          <Image
            src={photos.crowdSauconyVan.src}
            alt={photos.crowdSauconyVan.alt}
            widths={[480, 800]}
            sizes="(max-width: 860px) 92vw, 36vw"
          />
        </div>
      </section>

      <!-- Scene: Get involved -->
      <section class="ct-scene ct-involved" aria-labelledby="involved-title">
        <div class="ct-involved__copy">
          <h2 id="involved-title">Get involved</h2>
          <p>
            Amor Run Club is your gateway to fitness and fun. Every stride brings joy and new friendships, whether you’re
            a seasoned runner or just starting out. We run scenic routes through Rome, then stay for social events to
            bond over shared passions. Come run with us and discover the magic of running together.
          </p>
          <a class="ct-btn" href={site.links.whatsapp} rel="noopener" target="_blank">Join our WhatsApp community</a>
        </div>
        <div class="ct-frame ct-frame--tilt ct-wipe">
          <Image
            src={photos.handshakePiazza.src}
            alt={photos.handshakePiazza.alt}
            widths={[480, 800]}
            sizes="(max-width: 860px) 92vw, 40vw"
          />
        </div>
      </section>

      <!-- Red title card -->
      <section class="ct-redcard" aria-labelledby="quote">
        <figure class="ct-wipe">
          <blockquote>
            <p id="quote">Eat pasta run fasta.</p>
          </blockquote>
          <figcaption>Anonymous runner</figcaption>
        </figure>
        <div class="ct-runner ct-runner--red" aria-hidden="true">
          <img src="/cartoon/speed-lines.svg" alt="" class="ct-runner__lines" />
          <Image src={mascot} alt="" width={260} class="ct-runner__mascot" />
        </div>
      </section>

      <!-- Film strip -->
      <section class="ct-scene ct-gallery" id="gallery" aria-labelledby="gallery-title">
        <div class="ct-gallery__head">
          <h2 id="gallery-title">Scenes from the club</h2>
          <p>Scroll the reel, or focus it and use your arrow keys.</p>
        </div>
        <div class="ct-strip" tabindex="0" role="region" aria-label="Photo film strip, scrollable">
          <ul>
            {gallery.map((p) => (
              <li>
                <Image src={p.src} alt={p.alt} widths={[320, 560]} sizes="(max-width: 700px) 72vw, 340px" />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Join the cast -->
      <section class="ct-scene ct-join" id="join" aria-labelledby="join-title">
        <div class="ct-join__card ct-wipe">
          <div class="ct-join__intro">
            <h2 id="join-title">Join the cast</h2>
            <p>No auditions. Leave your name and email and we’ll send you the next run. Free, every pace.</p>
            <Image src={mascot} alt="" width={180} class="ct-join__mascot" />
          </div>

          <div class="ct-join__form">
            <form data-entry-form novalidate>
              <div class="ct-field">
                <label for="f-name">Name</label>
                <input id="f-name" name="name" type="text" autocomplete="name" aria-describedby="e-name" required />
                <p class="ct-error" id="e-name" data-error-for="name" aria-live="polite"></p>
              </div>
              <div class="ct-field">
                <label for="f-email">Email</label>
                <input id="f-email" name="email" type="email" autocomplete="email" aria-describedby="e-email" required />
                <p class="ct-error" id="e-email" data-error-for="email" aria-live="polite"></p>
              </div>
              <div class="ct-field">
                <label for="f-ig">Instagram <span class="ct-opt">(optional)</span></label>
                <input id="f-ig" name="instagram" type="text" placeholder="@yourhandle" aria-describedby="e-ig" />
                <p class="ct-error" id="e-ig" data-error-for="instagram" aria-live="polite"></p>
              </div>
              <div class="ct-check">
                <input id="f-accept" name="accept" type="checkbox" aria-describedby="e-accept" />
                <label for="f-accept">I accept the Release of Liability</label>
                <button type="button" class="ct-link" data-open-release>Read it</button>
              </div>
              <p class="ct-error" id="e-accept" data-error-for="accept" aria-live="polite"></p>
              <button type="submit" class="ct-btn ct-btn--big ct-submit">
                <span class="ct-submit__idle">Join the club</span>
                <span class="ct-submit__busy">Rolling film…</span>
              </button>
            </form>
            <div class="ct-success" data-form-success hidden>
              <p class="ct-credit">And introducing</p>
              <h3><span data-success-name></span>!</h3>
              <p>You’re in the cast. Watch your inbox and our Instagram for the next run.</p>
              <a class="ct-btn" href={site.links.instagram} rel="noopener" target="_blank">Follow on Instagram</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <dialog class="ct-credits" id="release" aria-labelledby="release-heading">
      <div class="ct-credits__bar">
        <p id="release-heading" class="ct-credit">The fine print</p>
        <form method="dialog"><button class="ct-btn ct-btn--small" type="submit">Close</button></form>
      </div>
      <div class="ct-credits__scroll">
        <ReleaseText headingLevel={2} />
      </div>
    </dialog>

    <footer class="ct-footer">
      <p class="ct-footer__end">That’s all, runners!</p>
      <ul class="ct-footer__social">
        <li><a href={site.links.instagram} rel="noopener" target="_blank">Instagram</a></li>
        <li><a href={site.links.strava} rel="noopener" target="_blank">Strava</a></li>
        <li><a href={site.links.whatsapp} rel="noopener" target="_blank">WhatsApp</a></li>
      </ul>
      <p>© {year} {site.legalName} · {site.legal.address}</p>
      <p>VAT {site.legal.vat} · Tax code {site.legal.taxCode}</p>
      <p class="ct-footer__note">Design concept for amorrunclub.com — example, not the official site. <a href="/">All directions</a></p>
    </footer>

    <script>
      import { initEntryForms } from "../../scripts/entry-form";
      import { initHeroVideo } from "../../scripts/hero-video";
      initEntryForms();
      initHeroVideo();

      const dlg = document.getElementById("release") as HTMLDialogElement | null;
      document.querySelectorAll("[data-open-release]").forEach((b) =>
        b.addEventListener("click", () => dlg?.showModal())
      );
      dlg?.addEventListener("click", (e) => {
        if (e.target === dlg) dlg.close();
      });

      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!CSS.supports("animation-timeline: view()") && !reduce && "IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) { en.target.classList.add("is-in"); io.unobserve(en.target); }
          });
        }, { threshold: 0.2 });
        document.querySelectorAll(".ct-wipe").forEach((el) => { el.classList.add("io"); io.observe(el); });
      }
    </script>
  </body>
</html>
