---
import { directions, logo } from "../data/site";
import { Image } from "astro:assets";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={import.meta.env.BASE_URL + "brand/icon-192.png"} />
    <title>Amor Run Club · four directions</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main>
      <Image src={logo} alt="Amor Run Club" width={160} height={160} />
      <h1>Amor Run Club redesign: pick a direction</h1>
      <p>Four complete takes on amorrunclub.com, built from the same content, photos and legal text.</p>
      <ol>
        {
          directions.map((d) => (
            <li>
              <a href={`${import.meta.env.BASE_URL}${d.slug}/`}>{d.name}</a>
              <span>{d.summary}</span>
            </li>
          ))
        }
      </ol>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    font-family: system-ui, sans-serif;
    background: #f4f2ee;
    color: #1d1b1a;
  }
  main {
    max-width: 44rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  p {
    color: #55504b;
    max-width: 60ch;
  }
  ol {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    gap: 0.75rem;
    counter-reset: d;
  }
  li {
    counter-increment: d;
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 1.25rem 1.1rem 3.25rem;
    position: relative;
    background: #fff;
    border-radius: 12px;
  }
  li::before {
    content: counter(d);
    position: absolute;
    left: 1.25rem;
    top: 1.1rem;
    font-weight: 700;
    color: #c8261d;
  }
  a {
    font-weight: 650;
    font-size: 1.15rem;
    color: inherit;
    text-decoration-color: #c8261d;
    text-underline-offset: 0.2em;
  }
  a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  li:has(a:hover) {
    outline: 2px solid #c8261d;
  }
  span {
    color: #55504b;
  }
</style>
