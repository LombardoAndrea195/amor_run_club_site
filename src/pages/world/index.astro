---
import "@fontsource/bowlby-one";
import "@fontsource-variable/hanken-grotesk";
import "../../styles/transitions.css";
import "../../styles/world.css";
import { Image } from "astro:assets";
import { site } from "../../data/site";
import { founders, schedule } from "../../data/world";
import mascot from "../../assets/mascot.png";

const base = import.meta.env.BASE_URL;
const title = "Amor Run Club · Fly through the club";

const stops = [
  {
    eyebrow: "Amor Run Club · Rome",
    title: "Run, laugh and connect",
    body: "A free social run club for every pace. Scroll to fly through the club’s Rome.",
    hint: true,
  },
  {
    eyebrow: "01 · Every " + schedule.social.day,
    title: "It starts in the piazza",
    body: schedule.social.what + " Meeting point and time go up on Instagram.",
    tags: ["Free", "Every pace", "Testaccio"],
  },
  {
    eyebrow: "02 · The founders",
    title: "Three friends, one club",
    body: "Meet the three founders behind Amor Run Club.",
    tags: founders.map((f) => f.name).filter((n) => n !== "Founder"),
  },
  {
    eyebrow: "03 · Brand interaction · Saucony",
    title: "Saucony × Amor",
    body: "From the Testaccio newsstand to Milano 21—with everyone in yellow—and the Rome Marathon, surrounded by Saucony shoes.",
    tags: ["Testaccio", "Milano 21", "Rome Marathon", "2026"],
    brand: true,
  },
  {
    eyebrow: "04 · Brand interaction · Adidas",
    title: "Adidas × Amor at EUR",
    body: "We ran at Parchetto dell’EUR, then a DJ kept the crew moving.",
    tags: ["Adidas", "EUR", "DJ set", "2026"],
    brand: true,
  },
  {
    eyebrow: "05 · The run",
    title: "A track around the Colosseum",
    body: "The crew runs lap after lap around Rome’s most iconic arena, on a proper track with marked lanes.",
    tags: ["Track", "Rome", "Every pace"],
  },
  {
    eyebrow: "06 · The finish line",
    title: "Eat pasta, run fasta",
    body: "Every run ends at a local spot: pasta shops, bars and aperitivo with the crew.",
    tags: ["Pasta", "Aperitivo"],
  },
  {
    eyebrow: "07 · Roma Half Marathon · 2026",
    title: "Brooks runs Rome",
    body: "21.1 km with the crew. Rome runs, Brooks on our feet.",
    tags: ["Brooks", "Rome", "21.1 km", "Crew"],
    brand: true,
  },
  {
    eyebrow: "08 · Pincio, Rome · 2026",
    title: "Training day at the Pincio",
    body: "An Under Armour session in the green, with Piazza di Spagna in view.",
    tags: ["Under Armour", "Pincio", "Piazza di Spagna", "Rome"],
    brand: true,
  },
  {
    eyebrow: "09 · Brand interaction · Garmin",
    title: "Garmin × Amor",
    body: "A Garmin event with the club, and pasta after.",
    tags: ["Rome", "Run data", "Community", "2026"],
    brand: true,
  },
  {
    eyebrow: "10 · Your turn",
    title: "Join the club",
    body: "Free to join, all paces welcome. Pick your door in:",
    cta: true,
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta name="theme-color" content="#f5e6cc" />
    <link rel="icon" href={base + "brand/icon-192.png"} />
  </head>
  <body class="w">
    <a class="w-skip" href="#join">Skip to sign up</a>

    <header class="w-bar">
      <a class="w-brand" href={base}>
        <Image src={mascot} alt="" width={64} />
        <span>Amor Run Club</span>
      </a>
      <a class="w-btn w-btn--small" href={base + "cartoon/#join"}>Join the club</a>
    </header>

    <canvas class="w-canvas" aria-hidden="true" data-world data-founders={JSON.stringify(founders.map((f) => ({ ...f, photo: f.photo ? base + "world/founders/" + f.photo : null })))}></canvas>
    <div class="w-loader" aria-hidden="true"><Image src={mascot} alt="" width={120} /></div>

    <nav class="w-rail" aria-label="Scenes">
      {stops.map((s, i) => (
        <button type="button" data-dot aria-current={i === 0 ? "true" : "false"}>
          <span class="w-sr">{s.title}</span>
        </button>
      ))}
    </nav>

    <main class="w-track" data-track>
      <div class="w-stage">
        {stops.map((s, i) => (
          <section class:list={["w-panel", { "w-panel--hero": i === 0, "w-panel--brand": s.brand, "w-panel--cta": s.cta }]} data-panel id={s.cta ? "join" : undefined} aria-labelledby={`stop-${i}`}>
            <div class="w-card">
              <p class="w-eyebrow">{s.eyebrow}</p>
              {i === 0 ? <h1 id={`stop-${i}`}>{s.title}</h1> : <h2 id={`stop-${i}`}>{s.title}</h2>}
              <p class="w-body">{s.body}</p>
              {s.tags && s.tags.length > 0 && (
                <ul class="w-tags">
                  {s.tags.map((t) => <li>{t}</li>)}
                </ul>
              )}
              {s.cta && (
                <div class="w-ctas">
                  <a class="w-btn" href={base + "cartoon/#join"}>Sign up</a>
                  <a class="w-btn w-btn--ghost" href={site.links.whatsapp} rel="noopener" target="_blank">WhatsApp</a>
                  <a class="w-btn w-btn--ghost" href={site.links.instagram} rel="noopener" target="_blank">Instagram</a>
                  <a class="w-btn w-btn--ghost" href={site.links.strava} rel="noopener" target="_blank">Strava</a>
                </div>
              )}
              {s.hint && <p class="w-hint" aria-hidden="true"><span></span>Scroll</p>}
            </div>
          </section>
        ))}
      </div>
    </main>

    <script>
      import { initWorld } from "../../scripts/world/world";
      const panels = [...document.querySelectorAll<HTMLElement>("[data-panel]")];
      panels.forEach((p) => {
        const card = p.querySelector<HTMLElement>(".w-card")!;
        card.classList.add("t-stagger");
        [...card.children].forEach((c, i) => {
          c.classList.add("t-stagger-line");
          (c as HTMLElement).style.setProperty("--line", String(i));
        });
      });
      const run = () =>
        initWorld({
          canvas: document.querySelector("[data-world]")!,
          track: document.querySelector("[data-track]")!,
          panels: panels.map((p) => p.querySelector<HTMLElement>(".w-card")!),
          dots: [...document.querySelectorAll<HTMLButtonElement>("[data-dot]")],
          founders: JSON.parse(document.querySelector<HTMLElement>("[data-world]")!.dataset.founders ?? "[]"),
        });
      // signs are drawn with the display font, so wait for it
      document.fonts.load('64px "Bowlby One"').finally(run);
    </script>
  </body>
</html>
