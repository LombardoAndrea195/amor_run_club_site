---
import "@fontsource/bowlby-one";
import "@fontsource-variable/hanken-grotesk";
import "../../styles/transitions.css";
import "../../styles/world.css";
import { Image } from "astro:assets";
import { site } from "../../data/site";
import mascot from "../../assets/mascot.png";

const base = import.meta.env.BASE_URL;
const title = "Amor Run Club · Fly through the club";

const stops = [
  {
    eyebrow: "Amor Run Club · Rome",
    title: "Run, laugh and connect",
    body: "A free social run club for every pace. Scroll to fly through the club’s Rome.",
    hint: true,
  },
  {
    eyebrow: "01 · The meeting point",
    title: "It starts in the piazza",
    body: "Runners of every pace gather, say hi and warm up together. Meeting points are announced on Instagram.",
    tags: ["Free", "Every pace"],
  },
  {
    eyebrow: "02 · The run",
    title: "Through the streets of Rome",
    body: "Experience the joy of running together through the beautiful streets of the Eternal City.",
    tags: ["Social runs", "Rome"],
  },
  {
    eyebrow: "03 · Every pace",
    title: "Nobody gets left behind",
    body: "Seasoned runner or first 5K, our inclusive environment welcomes all levels. Walk, jog or fly.",
    tags: ["All levels", "Easy Run 5K"],
  },
  {
    eyebrow: "04 · The finish line",
    title: "Eat pasta, run fasta",
    body: "Runs end at Rome’s pasta shops, with local pasta makers and good company around the table.",
    tags: ["Pasta", "Friends"],
  },
  {
    eyebrow: "05 · The newsstand",
    title: "The Runner’s Journal",
    body: "Our Amor × Saucony edition took over a Testaccio newsstand, shoes, stories and all.",
    tags: ["Amor × Saucony", "Testaccio"],
  },
  {
    eyebrow: "06 · Your turn",
    title: "Join the club",
    body: "Free to join, all paces welcome. Pick your door in:",
    cta: true,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta name="theme-color" content="#f5e6cc" />
    <link rel="icon" href={base + "brand/icon-192.png"} />
  </head>
  <body class="w">
    <a class="w-skip" href="#join">Skip to sign up</a>

    <header class="w-bar">
      <a class="w-brand" href={base}>
        <Image src={mascot} alt="" width={64} />
        <span>Amor Run Club</span>
      </a>
      <a class="w-btn w-btn--small" href={base + "cartoon/#join"}>Join the club</a>
    </header>

    <canvas class="w-canvas" aria-hidden="true" data-world></canvas>
    <div class="w-loader" aria-hidden="true"><Image src={mascot} alt="" width={120} /></div>

    <nav class="w-rail" aria-label="Scenes">
      {stops.map((s, i) => (
        <button type="button" data-dot aria-current={i === 0 ? "true" : "false"}>
          <span class="w-sr">{s.title}</span>
        </button>
      ))}
    </nav>

    <main class="w-track" data-track>
      <div class="w-stage">
        {stops.map((s, i) => (
          <section class:list={["w-panel", { "w-panel--hero": i === 0, "w-panel--cta": s.cta }]} data-panel id={s.cta ? "join" : undefined} aria-labelledby={`stop-${i}`}>
            <div class="w-card">
              <p class="w-eyebrow">{s.eyebrow}</p>
              {i === 0 ? <h1 id={`stop-${i}`}>{s.title}</h1> : <h2 id={`stop-${i}`}>{s.title}</h2>}
              <p class="w-body">{s.body}</p>
              {s.tags && (
                <ul class="w-tags">
                  {s.tags.map((t) => <li>{t}</li>)}
                </ul>
              )}
              {s.cta && (
                <div class="w-ctas">
                  <a class="w-btn" href={base + "cartoon/#join"}>Sign up</a>
                  <a class="w-btn w-btn--ghost" href={site.links.whatsapp} rel="noopener" target="_blank">WhatsApp</a>
                  <a class="w-btn w-btn--ghost" href={site.links.instagram} rel="noopener" target="_blank">Instagram</a>
                  <a class="w-btn w-btn--ghost" href={site.links.strava} rel="noopener" target="_blank">Strava</a>
                </div>
              )}
              {s.hint && <p class="w-hint" aria-hidden="true"><span></span>Scroll</p>}
            </div>
          </section>
        ))}
      </div>
    </main>

    <script>
      import { initWorld } from "../../scripts/world/world";
      const panels = [...document.querySelectorAll<HTMLElement>("[data-panel]")];
      panels.forEach((p) => {
        const card = p.querySelector<HTMLElement>(".w-card")!;
        card.classList.add("t-stagger");
        [...card.children].forEach((c, i) => {
          c.classList.add("t-stagger-line");
          (c as HTMLElement).style.setProperty("--line", String(i));
        });
      });
      const run = () =>
        initWorld({
          canvas: document.querySelector("[data-world]")!,
          track: document.querySelector("[data-track]")!,
          panels: panels.map((p) => p.querySelector<HTMLElement>(".w-card")!),
          dots: [...document.querySelectorAll<HTMLButtonElement>("[data-dot]")],
        });
      // signs are drawn with the display font, so wait for it
      document.fonts.load('64px "Bowlby One"').finally(run);
    </script>
  </body>
</html>
